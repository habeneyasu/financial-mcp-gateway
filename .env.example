# MCP server
HOST=localhost
PORT=8000
MCP_PATH=/mcp
# MCP_URL=http://mcp:8000/mcp   # set in Docker Compose for chat → MCP

# Database
DATABASE_PATH=data/gateway.db

# Gemini (required for chat)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Chat
CHAT_PORT=8001

# Agent
AGENT_MAX_TOOL_ROUNDS=8

# OAuth (reserved for future auth integration)
# AUTH_HOST=localhost
# AUTH_PORT=8080
# AUTH_REALM=master
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# MCP_SCOPE=mcp:tools
